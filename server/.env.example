# MongoDB connection string.
# Local example:  mongodb://127.0.0.1:27017/naik-foods-cart
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/naik-foods-cart
MONGODB_URI=mongodb://127.0.0.1:27017/naik-foods-cart

# Port the Express server listens on
PORT=5000

# Comma separated list of origins allowed to call this API.
# During local development this is usually the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# The free delivery threshold used by the suggestions endpoint, in rupees.
FREE_DELIVERY_THRESHOLD=999
